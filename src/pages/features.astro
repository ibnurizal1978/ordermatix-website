---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Tersedia Fitur Ordermatix - B2B Order Management System Software"
>
  <p>&nbsp;</p>
  <p>&nbsp;</p>
  <main id="main">
    <!-- ======= Team Section ======= -->
    <section id="team" class="team">
      <div class="container" data-aos="fade-up">
        <header class="section-header">
          <h2>Tersedia Fitur Ordermatix</h2>
          <p>Fitur Siap Pakai Untuk Anda.</p>
        </header>

        <div class="row gy-4">
          <div
            class="col-lg-4 col-md-6 d-flex align-items-stretch"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="member">
              <div class="member-img">
                <img
                  src="/assets/img/feature/aplikasi-buyer-portal-order-barang-agen-distributor-pabrikan.jpg"
                  class="img-fluid"
                  alt="buyer portal feature for online ordering system"
                />
              </div>
              <div class="member-info">
                <h4>Portal Pembeli</h4>
                <p>
                  Satu tampilan untuk memantau seluruh proses pemesanan hingga
                  update terbaru status order sehingga proses pemesanan menjadi
                  lebih cepat tanpa perlu melakukan pencatatan secara manual.
                </p>
              </div>
            </div>
          </div>

          <div
            class="col-lg-4 col-md-6 d-flex align-items-stretch"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="member">
              <div class="member-img">
                <img
                  src="/assets/img/feature/software-aplikasi-penjualan-agen-distributor-pabrikan.jpg"
                  class="img-fluid"
                  alt="report feature for online ordering system"
                />
              </div>
              <div class="member-info">
                <h4>Laporan Penjualan</h4>
                <p>
                  Laporan penjualan produk bisa dipantau secara realtime. Anda
                  bisa lebih fokus pada strategi marketing, sehingga Anda
                  selangkah lebih maju dari kompetitor.
                </p>
              </div>
            </div>
          </div>

          <div
            class="col-lg-4 col-md-6 d-flex align-items-stretch"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            <div class="member">
              <div class="member-img">
                <img
                  src="/assets/img/feature/sistem-limit-kredit-buyer-distributor-agen.jpg"
                  class="img-fluid"
                  alt="limit credit feature for online ordering system"
                />
              </div>
              <div class="member-info">
                <h4>Limit Kredit</h4>
                <p>
                  Berikan limit kredit kepada buyer sesuai dengan kebijakan
                  perusahaan.
                </p>
              </div>
            </div>
          </div>

          <div
            class="col-lg-4 col-md-6 d-flex align-items-stretch"
            data-aos="fade-up"
            data-aos-delay="400"
          >
            <div class="member">
              <div class="member-img">
                <img
                  src="/assets/img/feature/fitur-diskon-pada-aplikasi-order-barang-agen-distributor-pabrikan.jpg"
                  class="img-fluid"
                  alt="discount rate feature for online ordering system"
                />
              </div>
              <div class="member-info">
                <h4>Fitur Diskon</h4>
                <p>
                  Diskon bisa diberikan berbeda untuk setiap buyer. Saat
                  melakukan pemesanan, sistem akan otomatis memberikan diskon
                  sesuai dengan diskon yang sudah ditentukan untuk buyer
                  tersebut.
                </p>
              </div>
            </div>
          </div>

          <div
            class="col-lg-4 col-md-6 d-flex align-items-stretch"
            data-aos="fade-up"
            data-aos-delay="400"
          >
            <div class="member">
              <div class="member-img">
                <img
                  src="/assets/img/feature/fitur-multi-tax-pada-aplikasi-order-barang-online-distributor-agen-pabrikan.jpg"
                  class="img-fluid"
                  alt="multi tax online ordering system"
                />
              </div>
              <div class="member-info">
                <h4>Fitur Pajak</h4>
                <p>
                  Anda bisa mengatur banyak elemen pajak yang akan otomatis
                  ditambahkan oleh sistem ketika buyer melakukan checkout.
                </p>
              </div>
            </div>
          </div>

          <div
            class="col-lg-4 col-md-6 d-flex align-items-stretch"
            data-aos="fade-up"
            data-aos-delay="400"
          >
            <div class="member">
              <div class="member-img">
                <img
                  src="/assets/img/feature/customizeable.jpg"
                  class="img-fluid"
                  alt="bikin sistem aplikasi order barang yang spesifik"
                />
              </div>
              <div class="member-info">
                <h4>Kustomisasi</h4>
                <p>
                  Kami menyediakan jasa kustomisasi untuk membuat aplikasi
                  sistem order barang yang sesuai kebutuhan perusahaan Anda.
                  Kami akan membantu menciptakan sistem order barang yang
                  disesuaikan dengan kebutuhan perusahaan Anda, sehingga sistem
                  order barang dapat berjalan dengan lancar dan efisien.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><!-- End Team Section -->
  </main><!-- End #main -->
</MainLayout>
