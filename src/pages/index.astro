---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Ordermatix - Sistem Order B2B Online untuk Pabrik dan Distributor"
>
  <link rel="canonical" href="https://ordermatix.com" />
  <!-- ======= Hero Section ======= -->
  <section id="hero" class="hero d-flex align-items-center text-center">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 d-flex flex-column justify-content-center">
          <h1 data-aos="fade-up">
            Sistem Order B2B Online untuk Pabrik dan Distributor
          </h1>
          <h2 data-aos="fade-up" data-aos-delay="400">
            Order dari distributor masuk otomatis, tanpa WhatsApp, tanpa
            telepon, tanpa catat manual.
          </h2>
          <div data-aos="fade-up" data-aos-delay="600">
            <div class="text-center">
              <a
                href="pricing"
                class="btn-get-started scrollto d-inline-flex align-items-center justify-content-center align-self-center"
              >
                <span>Jadwalkan Demo Gratis</span>
                <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div><!-- End Hero -->
  </section>

  <main id="main">
    <!-- ======= About Section ======= -->
    <section id="about" class="about">
      <div class="container" data-aos="fade-up">
        <div class="row gx-0">
          <div
            class="col-lg-6 d-flex align-items-center"
            data-aos="zoom-out"
            data-aos-delay="200"
          >
            <img
              src="/assets/img/software.webp"
              class="img-fluid"
              alt="software aplikasi order barang untuk distributor, agen, wholesaler dan pabrikan"
            />
          </div>

          <div
            class="col-lg-6 d-flex flex-column justify-content-center"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="content">
              <h3>Siapa Kami</h3>
              <h2>
                Ordermatix adalah sistem order online untuk pabrik dan
                distributor
              </h2>
              <p>
                Ordermatix menyederhanakan seluruh proses pemesanan B2B, mulai
                dari penerimaan pesanan hingga pembaruan status order, ke dalam
                satu platform otomatis yang mulus.
              </p>
              <div class="text-center text-lg-start">
                <a
                  href="pricing"
                  class="btn-read-more d-inline-flex align-items-center justify-content-center align-self-center"
                >
                  <span>Jadwalkan Demo Gratis</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><!-- End About Section -->

    <!-- ======= Features Section ======= -->
    <section id="features" class="features">
      <div class="container" data-aos="fade-up">
        <header class="section-header">
          <h2>Apakah Anda</h2>
          <p>Menghadapi Masalah ini?</p>
        </header>

        <!-- Feature Tabs -->
        <div class="row feture-tabs" data-aos="fade-up">
          <div class="col-lg-6">
            <!-- Tab Content -->
            <div class="tab-content">
              <div class="tab-pane fade show active" id="tab1">
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>
                    Saya harus mencatat pesanan secara manual karena mereka
                    order dari WA, email, SMS, atau chat
                  </h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>
                    Saya harus menghitung diskon secara manual ke setiap pembeli
                  </h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>
                    Saya harus memeriksa apakah limit kredit mereka masih
                    tersedia atau sudah habis
                  </h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>
                    Saya tidak tahu berapa banyak pendapatan yang saya miliki,
                    harus dihitung secara manual
                  </h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>Saya tidak tahu produk mana yang paling laku</h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>
                    Saya tidak tahu pelanggan mana yang paling sering order
                  </h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>
                    Saya ingin menghilangkan kerumitan perhitungan dan
                    pemeriksaan manual
                  </h4>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-check2"></i>
                  <h4>Saya ingin bisnis saya bergerak lebih cepat</h4>
                </div>
              </div><!-- End Tab 1 Content -->
            </div>
          </div>

          <div class="col-lg-6">
            <img
              src="/assets/img/masalah-order-barang.webp"
              class="img-fluid"
              alt="masalah order barang"
            />
          </div>
        </div><!-- End Feature Tabs -->
      </div>
    </section><!-- End Features Section -->

    <section id="about" class="about">
      <div class="container" data-aos="fade-up">
        <div class="row gx-0">
          <div
            class="col-lg-12 d-flex flex-column justify-content-center"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="content text-center">
              <h2>Jika jawaban untuk pertanyaan di atas adalah "Ya"?</h2>
              <p>
                Anda membutuhkan Ordermatix. Ordermatix menjawab semua
                pertanyaan di atas sehingga bisnis Anda dapat berjalan lebih
                cepat.
              </p>
              <div class="text-center">
                <a
                  href="pricing"
                  class="btn-read-more d-inline-flex align-items-center justify-content-center align-self-center"
                >
                  <span>Jadwalkan Demo Gratis</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><!-- End About Section -->
  </main>
</MainLayout>
