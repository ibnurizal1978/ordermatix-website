---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Hubungi Kami untuk Demo dan Info Lebih Lanjut - Aplikasi Order Barang untuk Pabrik dan Distributor"
>
  <p>&nbsp;</p>
  <main id="main">
    <!-- ======= About Section ======= -->
    <section id="about" class="about">
      <div class="container" data-aos="fade-up">
        <div class="row gx-0">
          <div
            class="col-lg-12 d-flex flex-column justify-content-center"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="content">
              <h3><!--?= __( 'contact_title') ?--></h3>
              <h2><!--?= __( 'contact_desc') ?--></h2>
            </div>
          </div>
        </div>
        <br />

        <p>
          Ingin informasi lebih lanjut seputar sistem order barang pabrik dan
          distributor? Silahkan klik tombol di bawah ini untuk menjadwalkan
          diskusi secara online.
        </p>
        <br />
        <!-- https://calendly.com/vysera/ordermatix-demo -->
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/vysera/ordermatix-demo"
          style="min-width:320px;height:700px;"
        >
        </div>
        <script
          type="text/javascript"
          src="https://assets.calendly.com/assets/external/widget.js"
          async></script>
      </div>
    </section><!-- End About Section -->
  </main><!-- End #main -->
</MainLayout>
